# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Gmail OAuth (for email parsing)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ---------------------------------------------------------------------------
# PublishTrace — Builder.io content-to-live verification
# Put these in your own .env (never commit real values).
# ---------------------------------------------------------------------------
# Builder.io Public API Key (read-only). Found in Builder.io Space settings > API keys.
# Used only in REAL read-only check mode. Keep it out of logs and previews.
BUILDER_API_KEY=your_builder_public_api_key_here

# AI provider connection (optional — for the agent panel).
# PublishTrace works without an AI key in fixture demo mode.
# Set one of these to enable real AI-agent investigation runs.
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

