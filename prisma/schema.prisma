// =============================================================================
// NotaryPro SaaS - Prisma Schema
// =============================================================================
// Database: SQLite (default for local development)
// For production, switch to PostgreSQL:
//   1. Change provider to "postgresql"
//   2. Change DATABASE_URL to postgresql://user:password@host:5432/dbname
//   3. Run: npx prisma migrate dev --name init
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── For PostgreSQL production, replace the datasource block above with: ──
// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clients       Client[]
  signings      Signing[]
  invoices      Invoice[]
  expenses      Expense[]
  journalEntries JournalEntry[]
  settings      Settings?
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signings  Signing[]
  invoices  Invoice[]

  @@index([userId])
  @@index([createdAt])
}

model Signing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime
  time        String?
  location    String
  serviceType String   @default("General Notary")
  fee         Decimal  @default(0)
  status      String   @default("Scheduled")
  notes       String?
  mileage     Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices    Invoice[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([date])
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNo   String   @unique
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  signingId   String?
  signing     Signing? @relation(fields: [signingId], references: [id])
  amount      Decimal
  status      String   @default("Unpaid")
  issuedDate  DateTime @default(now())
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([issuedDate])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  description String
  amount      Decimal
  date        DateTime
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([date])
}

model JournalEntry {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signerName            String
  idType                String   @default("")
  idNumber              String   @default("")
  idExpiry              String   @default("")
  documentType          String   @default("")
  documentDescription   String   @default("")
  pageCount             Int      @default(0)
  fee                   Decimal  @default(0)
  date                  String
  time                  String   @default("")
  state                 String   @default("")
  county                String   @default("")
  notaryActType         String   @default("")
  notes                 String   @default("")
  signatureDataUrl      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

model Settings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String   @default("My Notary Business")
  commissionNumber    String   @default("")
  state               String   @default("")
  phone               String   @default("")
  email               String   @default("")
  commissionExpiry    String   @default("")
  telegramEnabled     Boolean  @default(false)
  telegramChatId      String   @default("")
  telegramBotToken    String   @default("")
  telegramUseCustomBot Boolean @default(false)
  notifNewSigning     Boolean  @default(true)
  notifSigningCompleted Boolean @default(true)
  notifSigningCancelled Boolean @default(false)
  notifSigningReminder Boolean @default(true)
  notifInvoiceCreated Boolean  @default(true)
  notifInvoicePaid    Boolean  @default(true)
  notifInvoiceOverdue Boolean  @default(true)
  notifExpenseAdded   Boolean  @default(false)
  notifWeeklySummary  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}
